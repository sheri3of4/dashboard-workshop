# Secrets. Keys and passwords live in .env on your laptop and in your host's settings, never in git.
.env
.env.*
!.env.example

# The local data cache: raw, row-level files. Only its README is kept.
data/raw/*
!data/raw/README.md

# Build output and installed packages
node_modules/
dist/
.netlify/
# Framework's cache, except the pinned browser libraries, which are committed so builds
# never fetch chart code from the internet.
src/.observablehq/cache/*
!src/.observablehq/cache/_npm/
.venv/
__pycache__/

# OS clutter
.DS_Store
Thumbs.db
